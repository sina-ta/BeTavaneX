# Staging environment template (no secrets committed)

APP_ENV=staging
DATABASE_URL=postgresql://betavanx_app:REPLACE_ME@staging-db:5432/betavanx_staging

BETAVANX_AUTH_SECRET=REPLACE_WITH_STAGING_SECRET
BETAVANX_AUTH_TOKEN_TTL=3600
BETAVANX_CORS_ORIGINS=https://staging.betavanx.example

LOG_LEVEL=INFO
LOG_JSON=true
SLOW_QUERY_MS=400
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REQUIRE_ALEMBIC_HEAD=true
SKIP_STARTUP_VALIDATION=false
LEGACY_API_ENABLED=false
BETAVANX_ENABLE_WORKFORCE_EXTENSION=false
