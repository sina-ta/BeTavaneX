# BetavanX environment template (placeholder values only — no secrets)

# Primary PostgreSQL connection (Phase 1 / Alembic / SQLAlchemy)
DATABASE_URL=postgresql://betavanx_app:change_me@localhost:5432/betavanx_dev

# Log SQL statements when true
DB_ECHO=false

# Application environment: development | staging | production
APP_ENV=development

# JWT signing secret (required non-default for staging/production)
BETAVANX_AUTH_SECRET=dev-secret-change-me
BETAVANX_AUTH_TOKEN_TTL=3600

# Comma-separated browser origins for CORS
BETAVANX_CORS_ORIGINS=http://localhost:3000

# Observability
LOG_LEVEL=INFO
LOG_JSON=false
SLOW_QUERY_MS=500
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Startup / migrations
REQUIRE_ALEMBIC_HEAD=false
SKIP_STARTUP_VALIDATION=false

# Mount legacy HTTP routes when true (default off)
LEGACY_API_ENABLED=false

# Register workforce extension models and routes when true
BETAVANX_ENABLE_WORKFORCE_EXTENSION=false

# Optional: compose DATABASE_URL from parts if DATABASE_URL is unset
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=betavanx_dev
# DB_USER=betavanx_app
# DB_PASSWORD=change_me
