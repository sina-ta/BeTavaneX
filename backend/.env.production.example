# Production environment template (inject via secret manager — never commit)

APP_ENV=production
DATABASE_URL=postgresql://betavanx_app:REPLACE_ME@production-db:5432/betavanx_prod

BETAVANX_AUTH_SECRET=REPLACE_WITH_PRODUCTION_SECRET
BETAVANX_AUTH_TOKEN_TTL=1800
BETAVANX_CORS_ORIGINS=https://app.betavanx.example

LOG_LEVEL=WARNING
LOG_JSON=true
SLOW_QUERY_MS=300
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

REQUIRE_ALEMBIC_HEAD=true
SKIP_STARTUP_VALIDATION=false
LEGACY_API_ENABLED=false
BETAVANX_ENABLE_WORKFORCE_EXTENSION=false
