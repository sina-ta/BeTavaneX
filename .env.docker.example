# Docker Compose environment (copy to .env.docker — never commit secrets)

APP_ENV=development
POSTGRES_USER=betavanx_app
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=betavanx_dev
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

BETAVANX_AUTH_SECRET=dev-secret-change-me
BETAVANX_AUTH_TOKEN_TTL=3600
BETAVANX_CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
LOG_JSON=false
SLOW_QUERY_MS=500
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

REQUIRE_ALEMBIC_HEAD=false
SKIP_STARTUP_VALIDATION=false
# Schema: use Alembic only in Docker (default). Do not enable bootstrap unless debugging.
RUN_SCHEMA_BOOTSTRAP=false
RUN_ALEMBIC_UPGRADE=true
